# Copy this file to .env and fill in the values. Never commit .env.
# On your own machine only DJANGO_SECRET_KEY is needed.

# Required everywhere. Long random text, for example the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Stripe sandbox (Developers -> API keys): needed on your machine only for
# `python manage.py check_payments` and trying payments. Never commit these.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary (photos): the console's API environment variable, with the secret.
# Without it, photos are kept in media/ on your machine. Never commit it.
# CLOUDINARY_URL=cloudinary://<api key>:<api secret>@<cloud name>

# ---------- Staging and production only ----------

# Keys for encrypted columns (addresses), comma separated; the first encrypts.
# Optional on your own machine. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DJANGO_FIELD_ENCRYPTION_KEYS=

# The database: Neon's pooled connection string (host contains "-pooler"), and the
# direct one for migrations. Set them in Render's dashboard, never in a file in Git.
# DATABASE_URL=postgres://user:password@ep-example-pooler.us-east-1.aws.neon.tech/samwab?sslmode=require
# DIRECT_DATABASE_URL=postgres://user:password@ep-example.us-east-1.aws.neon.tech/samwab?sslmode=require

# Until an email service is chosen: write emails (sign-up codes) to the logs instead.
# DJANGO_EMAIL_TO_LOGS=true

# Extra host names the API answers to, and front-end addresses allowed to send
# forms (comma separated). Render's own address is added automatically.
# DJANGO_ALLOWED_HOSTS=api.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# The web app's address, used for links in emails. Default http://localhost:3000
# DJANGO_FRONTEND_URL=https://example.com

# Sales tax from Stripe Tax (build E22). Leave off until Stripe Tax is switched on
# in the Stripe dashboard with the Illinois registration.
# DJANGO_SALES_TAX_ENABLED=true
# DJANGO_SALES_TAX_CODE=txcd_99999999

# Order emails: the "Track your order" link, the company's legal name, and where
# buyers' replies go (empty: no reply address).
# DJANGO_ORDER_PAGE_URL=https://example.com/account/orders/{order_id}
# DJANGO_COMPANY_LEGAL_NAME=SAMWAB Luxury, LLC
# DJANGO_SUPPORT_EMAIL=care@example.com

# Who emails come from, and the email provider's SMTP details.
# On your own machine emails are printed in the runserver terminal instead.
# DJANGO_DEFAULT_FROM_EMAIL=Samwab <no-reply@example.com>
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
